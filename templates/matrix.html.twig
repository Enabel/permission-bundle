{#-
    The permission matrix: one table, so a role keeps the same column from the
    first domain to the last; each domain is a group of rows under its name.

        {% include '@EnabelPermission/matrix.html.twig' with {matrix: matrix} %}

    `matrix` is the Enabel\Permission\Matrix\PermissionMatrix service. To label
    the permissions, embed it and override `permission_label` (`row` is a MatrixRow).
-#}
{% set roles = matrix.roles %}
{% set domains = matrix.domains %}
{% if domains is empty %}
    <p class="text-body-secondary">{{ 'matrix.empty' | trans({}, 'enabel_permission') }}</p>
{% else %}
    <div class="table-responsive enabel-permission-matrix">
        <table class="table table-sm table-hover align-middle mb-0">
            {#- Every other role column is shaded, to follow a column down the table. -#}
            <colgroup>
                <col>
                {% for role in roles %}
                    <col{% if loop.index is odd %} class="bg-body-tertiary"{% endif %}>
                {% endfor %}
                <col>
            </colgroup>
            <thead class="sticky-top bg-body">
                <tr>
                    <th scope="col">{{ 'matrix.permission' | trans({}, 'enabel_permission') }}</th>
                    {% for role in roles %}
                        <th scope="col" class="text-center small"><code>{{ role }}</code></th>
                    {% endfor %}
                    <th scope="col">{{ 'matrix.relations' | trans({}, 'enabel_permission') }}</th>
                </tr>
            </thead>
            {% for domain, rows in domains %}
                <tbody data-domain="{{ domain }}">
                    <tr class="table-light">
                        <th scope="rowgroup" colspan="{{ roles | length + 2 }}" class="fw-semibold">{{ domain }}</th>
                    </tr>
                    {% for row in rows %}
                        <tr data-permission="{{ row.value }}">
                            <th scope="row" class="fw-normal">
                                {% block permission_label %}{{ row.name }}{% endblock %}<br>
                                <code class="small">{{ row.value }}</code>
                            </th>
                            {% for role in roles %}
                                <td class="text-center" data-role="{{ role }}">
                                    {%- if row.roles[role] -%}
                                        <span aria-hidden="true">&#10003;</span>
                                        <span class="visually-hidden">{{ 'matrix.granted' | trans({}, 'enabel_permission') }}</span>
                                    {%- endif -%}
                                </td>
                            {% endfor %}
                            <td>
                                {#- The app may label its relations under relation.<name> in the enabel_permission domain. -#}
                                {% for relation in row.relations %}
                                    {% set key = 'relation.' ~ relation %}
                                    {% set label = key | trans({}, 'enabel_permission') %}
                                    <span class="badge text-bg-light">{{ label == key ? relation : label }}</span>
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            {% endfor %}
        </table>
    </div>
{% endif %}
<p class="small text-body-secondary mt-2">{{ 'matrix.inheritance' | trans({}, 'enabel_permission') }}</p>
